@prefix akgg: <https://example.org/akgg#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/akgg> a owl:Ontology ;
    rdfs:comment "Lightweight AKGG ontology reconstructed from the ontology design stated in AKGG_revised_v2.tex. No standalone OWL/Turtle ontology file was present in the uploaded ZIP." .

akgg:Domain a owl:Class .
akgg:Concept a owl:Class .
akgg:Region a owl:Class .
akgg:Learner a owl:Class .
akgg:LearnerState a owl:Class .
akgg:Quest a owl:Class .
akgg:Boss a owl:Class .
akgg:Misconception a owl:Class .

akgg:hasConcept a owl:ObjectProperty .
akgg:hasPrerequisite a owl:ObjectProperty .
akgg:supportsConcept a owl:ObjectProperty .
akgg:hasLearnerState a owl:ObjectProperty .
akgg:forConcept a owl:ObjectProperty .
akgg:hasMisconception a owl:ObjectProperty .
akgg:locatedInRegion a owl:ObjectProperty .

akgg:masteryScore a owl:DatatypeProperty ;
    rdfs:range xsd:float .
akgg:priorityScore a owl:DatatypeProperty ;
    rdfs:range xsd:float .
akgg:difficulty a owl:DatatypeProperty ;
    rdfs:range xsd:float .
akgg:xp a owl:DatatypeProperty ;
    rdfs:range xsd:integer .
akgg:level a owl:DatatypeProperty ;
    rdfs:range xsd:integer .
akgg:status a owl:DatatypeProperty ;
    rdfs:range xsd:string .
